# Copy to .env and fill in. Never commit .env.

# openai | mock  (mock = offline demo / tests)
LLM_PROVIDER=openai
OPENAI_API_KEY=

# Confirm available model names in the OpenAI console before the demo.
CHAT_MODEL=gpt-4.1-mini
EXTRACT_MODEL=gpt-4.1-mini
ASR_MODEL=gpt-4o-transcribe
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=coral
VISION_MODEL=gpt-4.1-mini

# Fall detection (fall-mcp)
# FALL_SOURCE=demo/videos/walk.mp4   # video path or camera index (0); empty = wait for start_monitoring
# FALL_CAMERA=0                      # camera index for the dashboard's Camera button
# FALL_DEVICE=cpu                    # cpu | mps (Apple Silicon) | 0 (CUDA)
